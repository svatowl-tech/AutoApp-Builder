{
  "name": "autoapp-builder",
  "private": false,
  "version": "0.1.0-alpha.1",
  "description": "Кроссплатформенный десктопный оркестратор сборки и автообновления GitHub-проектов в автономные бинарники (.exe, .dmg, .AppImage, .apk) с самоисцелением через локальный ИИ (Early Stage Alpha)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/public-release/autoapp-builder.git"
  },
  "keywords": [
    "electron",
    "react-19",
    "orchestrator",
    "binary-builder",
    "local-ai",
    "gguf",
    "apk-builder",
    "early-access"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:electron": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','dist-electron','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
