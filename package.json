{
  "name": "autoapp-builder",
  "private": false,
  "version": "0.1.0-alpha.1",
  "description": "Кроссплатформенный десктопный оркестратор сборки и автообновления GitHub-проектов в автономные бинарники (.exe, .dmg, .AppImage, .apk) с самоисцелением через локальный ИИ (Early Stage Alpha)",
  "author": "AutoApp-Builder Open Source Team <maintainers@autoapp-builder.org>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/public-release/autoapp-builder.git"
  },
  "keywords": [
    "electron",
    "react-19",
    "orchestrator",
    "binary-builder",
    "local-ai",
    "gguf",
    "apk-builder",
    "early-access"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:electron": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','dist-electron','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": ">=4.0.0",
    "@vitejs/plugin-react": ">=4.3.0",
    "lucide-react": ">=0.460.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": ">=6.0.0",
    "express": "^4.21.2",
    "dotenv": ">=16.4.0",
    "motion": ">=12.0.0"
  },
  "devDependencies": {
    "@types/node": ">=22.0.0",
    "@types/react": ">=19.0.0",
    "@types/react-dom": ">=19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": ">=0.24.0",
    "tailwindcss": ">=4.0.0",
    "tsx": ">=4.19.0",
    "typescript": ">=5.7.0",
    "@types/express": "^4.17.21"
  }
}
