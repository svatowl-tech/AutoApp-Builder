{
  "name": "autoapp-wrapped-executable",
  "version": "1.0.0",
  "description": "Автономный исполняемый контейнер, сгенерированный оркестратором AutoApp-Builder",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win portable --x64",
    "pack:mac": "electron-builder --mac dmg --x64 --arm64",
    "pack:linux": "electron-builder --linux AppImage --x64"
  },
  "build": {
    "appId": "com.autoapp.wrapped.app",
    "productName": "AutoAppWrapped",
    "asar": true,
    "files": [
      "main.js",
      "www/**/*"
    ],
    "win": {
      "target": ["portable"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "devDependencies": {
    "electron": "35.0.0",
    "electron-builder": "25.1.8"
  }
}
