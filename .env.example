# Порт локального сервера оркестратора (для веб-превью и IPC-моста)
PORT=3000

# Настройки локального ИИ-движка по умолчанию (100% бесплатно, без облачных платных ключей)
AI_PROVIDER_MODE="builtin-llama"
BUILTIN_LLAMA_HOST="127.0.0.1"
BUILTIN_LLAMA_PORT="8080"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
LOCAL_SERVER_BASE_URL="http://127.0.0.1:1234/v1"
CUSTOM_OPENAI_BASE_URL="http://127.0.0.1:8000/v1"
CUSTOM_OPENAI_API_KEY=""

# Лимиты единого централизованного кэша (в гигабайтах)
SHARED_CACHE_MAX_GB="10"
SYSTEM_MIN_FREE_DISK_GB="5"
